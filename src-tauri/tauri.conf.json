{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiger Sticky Notes",
  "version": "0.1.0",
  "identifier": "me.tigerstickynotes.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Tiger Sticky Notes", "width": 1280, "height": 820, "minWidth": 700, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; frame-src https://verify.proton.me; connect-src 'self' ipc: http://ipc.localhost https://*.proton.me"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
