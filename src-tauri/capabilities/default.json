{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core plus HTTP to Proton only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    { "identifier": "http:default", "allow": [{ "url": "https://*.proton.me/*" }, { "url": "https://proton.me/*" }] }
  ]
}
